<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(SpireUnityTestHost)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(SpireUnityTestHost)' == 'true'">netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsTestProject Condition="'$(SpireUnityTestHost)' != 'true'">true</IsTestProject>
    <DefineConstants Condition="'$(SpireUnityTestHost)' == 'true'">$(DefineConstants);SPIRE_UNITY_TEST_HOST</DefineConstants>
    <CopyLocalLockFileAssemblies Condition="'$(SpireUnityTestHost)' == 'true'">true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/DevTools/DevTools.csproj" />
    <ProjectReference Include="../../tools/Spire.Tool.Core/Spire.Tool.Core.csproj" />
    <ProjectReference Include="../../tools/Spire.Tool/Spire.Tool.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      Condition="'$(SpireUnityTestHost)' != 'true'" />
    <ProjectReference Include="../../tools/UnityTestDependencies/UnityTestDependencies.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../src/Houtamelo.Spire/Houtamelo.Spire.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" Condition="'$(SpireUnityTestHost)' != 'true'" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" Condition="'$(SpireUnityTestHost)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(SpireUnityTestHost)' == 'true'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
</Project>
