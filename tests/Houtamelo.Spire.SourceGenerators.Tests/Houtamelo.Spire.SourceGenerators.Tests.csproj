<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(SpireUnityTestHost)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(SpireUnityTestHost)' == 'true'">netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <IsTestProject Condition="'$(SpireUnityTestHost)' != 'true'">true</IsTestProject>
    <DefineConstants Condition="'$(SpireUnityTestHost)' == 'true'">$(DefineConstants);SPIRE_UNITY_TEST_HOST</DefineConstants>
    <CopyLocalLockFileAssemblies Condition="'$(SpireUnityTestHost)' == 'true'">true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701;xUnit1003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/cases/**" />
    <None Include="**/cases/**" Exclude="bin/**;obj/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Compatibility/manifest.json;Compatibility/fixturedata/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Houtamelo.Spire.Analyzers\Houtamelo.Spire.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Houtamelo.Spire\Houtamelo.Spire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" Condition="'$(SpireUnityTestHost)' != 'true'" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" Condition="'$(SpireUnityTestHost)' != 'true'" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.10.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Houtamelo.Spire.CodeFixes\Houtamelo.Spire.CodeFixes.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SpireUnityTestHost)' == 'true'">
    <Compile Include="../Shared/UnityTestHost.cs" Link="Hosting/UnityTestHost.cs" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
</Project>
