<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GuardFlowRoslynVersion Condition="'$(GuardFlowRoslynVersion)' == ''">4.10.0</GuardFlowRoslynVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SpireGuardFlowSdkVersion" Value="$(NETCoreSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Houtamelo.Spire.Analyzers/Houtamelo.Spire.Analyzers.csproj" />
    <ProjectReference Include="../../src/Houtamelo.Spire/Houtamelo.Spire.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(GuardFlowRoslynVersion)" />
  </ItemGroup>
</Project>
